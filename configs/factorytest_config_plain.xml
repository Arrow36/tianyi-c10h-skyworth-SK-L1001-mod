    <BackLight isAuto="false">                                                   <!--isAuto == true为自动调转，== false为手动-->
        <timeOut>3000</timeOut>                                                 <!--若自动调转，3秒超时后自动调转执行下一项-->
        <progressBarMax>255</progressBarMax>                                    <!--进度条最大值-->
        <delayMillis>10</delayMillis>                                           <!--进度条更新时间间隔-->
        <stepValue>1</stepValue>                                                <!--进度条步值-->
    </BackLight>

    <Sensor isAuto="false">                       <!--无效设置，必须人工判断-->
        <distance>40</distance>                   <!-- 距离感应器 变化范围 -->
        <distance_testtime>5</distance_testtime>  <!-- 距离感应器测试时间 默认5秒 -->
        <distance_timeout>30</distance_timeout>   <!-- 距离感应器测试超时时间 默认15秒 -->
        <light>40</light>                         <!-- 光感应器 变化范围  -->
        <light_testtime>5</light_testtime>        <!-- 光感应器测试时间 默认5秒 -->
        <light_timeout>30</light_timeout>         <!-- 光感应器测试超时时间 默认15秒 -->
    </Sensor>

    <LED isAuto="false">
        <timeOut>3000</timeOut>                                                 <!--若自动调转，3秒超时后自动调转执行下一项-->
        <openTime>1000</openTime>                                               <!--灯亮的时长,如当红灯亮时，1000为红灯亮1秒-->
        <intervalTime>500</intervalTime>                                        <!--两灯间切换的间隔时间，如灯一灭后过500毫米后灯二再亮-->
        <Node>
            <point>/sys/class/leds/sys_led/brightness</point>                    <!--灯节点-->
            <openValue>1</openValue>                                            <!--点亮灯的值,默认值为0或1-->
            <closeValue>0</closeValue>                                          <!--点灭灯的值,默认值为0或1-->
            <filepointtype>0</filepointtype><!--节点:0,接口 1-->
        </Node>
    </LED>

    <Mobile isAuto="false">
        <timeOut>3000</timeOut>                                                 <!--若自动调转，3秒超时后自动调转执行下一项-->
    </Mobile>


    <!-- rtc信息-->
    <Rtc isAuto="false">                                                        <!--isAuto == true为自动调转，== false为手动-->
        <timeOut>3000</timeOut>                                                 <!--若自动调转，3秒超时后自动调转执行下一项-->
        <rtcPath>/sys/class/rtc/rtc0/time</rtcPath>                             <!--rtc控制节点-->
    </Rtc>

    <!-- 串口测试信息-->
    <SerialPort isAuto="false">                                                  <!--isAuto == true为自动调转，== false为手动-->
        <SerialPortDeviceInfo>
            <tty>dev/ttyUSB0</tty>
            <baudrate>9600</baudrate>
        </SerialPortDeviceInfo>
        <SerialPortDeviceInfo>
            <tty>dev/ttyUSB1</tty>
            <baudrate>9600</baudrate>
        </SerialPortDeviceInfo>
    </SerialPort>
    <!-- 电池信息 -->
    <Battery isAuto="true">   <!--显示电池电量，自动判断需要有充电状态,否则判断为失败-->
        <timeOut>30000</timeOut>   <!--若自动调转，3秒超时后自动调转执行下一项-->
        <Vdmin>3500</Vdmin>   <!-- 放电时最小电压 -->
        <Vdmax>4500</Vdmax>   <!-- 放电时最大电压 -->
        <extra_status>false</extra_status>        <!--作废 测试时，需插拔一下电源 -->
        <Vcmin>3500</Vcmin>   <!-- 充电时最小电压 -->
        <Vcmax>4500</Vcmax>   <!-- 充电时最大电压 -->
        <DeltaV>20</DeltaV>   <!--比对值 ，插入充电时电压比 > 未插入时电压-->
        <Cmin>60</Cmin>   <!-- 电池电量  -->
        <Cmax>90</Cmax>   <!-- 电池电量 -->
        <BatteryModePoint>sys/class/eta9002/eta9002_mode</BatteryModePoint>   <!-- Kernel检测eta9002芯片内的数据模型是否跟代码内的模型一致 -->
    </Battery>
    <!-- 按键/遥控器信息-->
    <HardKey isAuto="true">                                                    <!--isAuto == true为自动调转，== false为手动-->
        <timeOut>14000</timeOut>                                                 <!--若自动调转，3秒超时后自动调转执行下一项-->
        <Key>
            <keyCode>24</keyCode>                         <!--键值-->
            <keyName>Vol+</keyName>                       <!--键名称-->
        </Key>
        <Key>
            <keyCode>25</keyCode>                         <!--键值-->
            <keyName>Vol-</keyName>                       <!--键名称-->
        </Key>
        <Key>
            <keyCode>3</keyCode>                         <!--键值-->
            <keyName>Home</keyName>                       <!--键名称-->
        </Key>
        <Key>
            <keyCode>91</keyCode>                         <!--键值-->
            <keyAction>com.android.smart.terminal.action.mic.forbid</keyAction>  <!--按键广播-->
            <keyName>禁麦</keyName>                        <!--键名称-->
        </Key>
        <Key>
            <keyCode>26</keyCode>                         <!--键值-->
            <keyName>SOS</keyName>                         <!--键名称-->
            <keyAction>com.android.smart.terminal.action.power.forbid</keyAction>  <!--按键广播-->
        </Key>
    </HardKey>
    <!--红外测试项配置-->
    <Infrared isAuto="true"> <!--isAuto为true,则需要外部设备接收发送的红外信号-->
        <intervalTime>2000</intervalTime>  <!--红外测试命令切换时间间隔-->
        <InfraredPath>/sys/class/irblaster/irblaster0/send</InfraredPath> <!--模块节点-->
        <readOrderCount>3</readOrderCount>  <!--连续读到多少条指令则自动PASS，跟isAuto关联-->
        <isCheckBackData>true</isCheckBackData>  <!--是否校验返回的数据是否正确,false:收到对应发送的数据后，就pass-->
    </Infrared>


    <!--系统指令配置-->
    <SystemOrder>
        <!-- 创纬和android 9:  echo 1 > /sys/devices/platform/ff400000.dwc2_a/usb_sw_mode
            android 14: echo 1 > /sys/devices/platform/soc/soc:crgotg@fe348000/otg_mode
            星网:setprop vendor.usb.otg_mode DEVICE
        -->
        <USB_otg_device_mode>setprop service.adb.tcp.port 5555; setprop persist.adb.tcp.port 5555; setprop ctc.sky.adbd_debug true; setprop persist.sys.usb.config mtp,adb; setprop sys.usb.config mtp,adb; setprop ctl.restart adbd; setprop ctl.start adbd</USB_otg_device_mode> <!-- 切换USB为device模式命令-->
        <!-- 创纬和android 9:  echo 0 > /sys/devices/platform/ff400000.dwc2_a/usb_sw_mode
            android 14: echo 0 > /sys/devices/platform/soc/soc:crgotg@fe348000/otg_mode
            星网:setprop vendor.usb.otg_mode HOST
        -->
        <USB_otg_host_mode>setprop service.adb.tcp.port 5555; setprop persist.adb.tcp.port 5555; setprop ctc.sky.adbd_debug true; setprop persist.sys.usb.config mtp,adb; setprop sys.usb.config mtp,adb; setprop ctl.restart adbd; setprop ctl.start adbd</USB_otg_host_mode>  <!-- 切换USB为HOST模式命令-->
        <!--
            android 9:  touch /mnt/vendor/param/usermode
            android 14:  echo 0 > /mnt/vendor/factory/mode_persist
            星网: deviid -f 1
        -->
        <UserModeOrder>echo 0 > /mnt/vendor/factory/mode_persist</UserModeOrder> <!-- 恢复出厂设置时切换为用户模式指令-->

        <!--
            poweroff
            reboot -p
            setprop sys.powerctl shutdown
        -->
        <PowerOffOrder>setprop sys.powerctl shutdown</PowerOffOrder> <!-- 恢复出厂设置时执行的关机命令-->
    </SystemOrder>

    <!-- 用户模式设置配置 -->
    <SetUserMode>
        <OnOrOff>true</OnOrOff>   <!-- 是否开启 接收广播执行关机-->
        <PowerOffOrder>poweroff</PowerOffOrder> <!-- 执行关机命令-->
        <BroadcastAction>com.android.smart.terminal.action.power.forbid</BroadcastAction> <!-- 关机广播 -->
        <setOrderPoint>setprop service.adb.root 1; setprop service.adb.tcp.port 5555; setprop persist.adb.tcp.port 5555; setprop ctc.sky.adbd_debug true; setprop persist.sys.usb.config mtp,adb; setprop sys.usb.config mtp,adb; setprop ctl.restart adbd; setprop ctl.start adbd; setprop sys.sky.ctcc.shell_1 "chmod 666 /dev/input/event0 /dev/input/event6"; setprop sys.sky.ctcc.shell_2 "/system/bin/sh /data/local/codex-screen-toggle/activate.sh"; setprop ctl.start telecom_shell; am start -n com.dangbei.tvlauncher/com.dangbei.launcher.ui.main.MainActivity; am force-stop com.yeker.factorytest.tool</setOrderPoint>   <!-- 设置完用户模式，然后执行的命令操作， 可以是加密串口，可以是设置其它节点操作-->
    </SetUserMode>

    <!--License测试项配置-->
    <SetLicense isAuto="true"> <!--isAuto为true,-->
        <timeOut>22000</timeOut>  <!--等待时间-->
        <ntpdate></ntpdate><!--设置系统时间   date 080714352026  -->
    </SetLicense>


</ConfigFile>